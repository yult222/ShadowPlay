<view class="container">
  <!-- 音频控制逻辑保留在 JS 的 onShow/onHide，此处不处理 -->

  <!-- 开场页 -->
  <view wx:if="{{stage === 'intro'}}" class="stage-view">
    <button bindtap="startExperience">开始体验</button>
  </view>

  <!-- 雕刻 & 上色 舞台 -->
  <view wx:elif="{{stage === 'carving' || stage === 'coloring'}}" class="stage-view">
    <!-- 舞台容器（固定比例） -->
    <view class="stage-container">
      <!-- 底图 -->
      <image class="layer base" src="/assets/experience/base.png" mode="widthFix" />

      <!-- 雕刻覆盖层（未完成的显示） -->
      <block wx:for="{{[0,1,2,3,4,5]}}" wx:key="index">
        <image
          wx:if="{{stage === 'carving' && index >= carvingStep}}"
          class="layer cover"
          src="/assets/experience/carve_cover_{{index}}.png"
          mode="widthFix"
        />
      </block>

      <!-- 上色覆盖层（未完成的显示） -->
      <block wx:for="{{[0,1,2,3,4,5]}}" wx:key="index">
        <image
          wx:if="{{stage === 'coloring' && index >= coloringStep}}"
          class="layer cover"
          src="/assets/experience/color_cover_{{index}}.png"
          mode="widthFix"
        />
      </block>

      <!-- 当前高亮层（雕刻起点/终点 或 上色热点） -->
      <view wx:if="{{stage === 'carving'}}" class="highlight-layer">
        <!-- 这里可放起点/终点提示，暂用文字示意 -->
        <view class="start-point" style="left: {{currentCarve.start.x}}px; top: {{currentCarve.start.y}}px;"></view>
        <view class="end-point" style="left: {{currentCarve.end.x}}px; top: {{currentCarve.end.y}}px;"></view>
      </view>

      <view wx:if="{{stage === 'coloring'}}" class="highlight-layer">
        <!-- 上色热点区域（用 view 模拟点击区） -->
        <view
          class="color-hotspot"
          style="left: {{currentColor.center.x - currentColor.radius}}px; top: {{currentColor.center.y - currentColor.radius}}px; width: {{currentColor.radius * 2}}px; height: {{currentColor.radius * 2}}px;"
          bindtap="onColorTap"
        ></view>
      </view>
    </view>
  </view>

  <!-- 成品页 -->
  <view wx:else class="stage-view finished">
    <image
      class="result-image"
      src="{{isSilhouette ? '/assets/experience/silhouette_placeholder.png' : '/assets/experience/base.png'}}"
      mode="widthFix"
    />
    <button bindtap="toggleView">切换{{isSilhouette ? '彩皮' : '剪影'}}</button>
    <button bindtap="saveImage">保存作品</button>
    <button bindtap="restart">重新制作</button>
  </view>
</view>