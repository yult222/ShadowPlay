.canvas-stage{position:relative;width:100%;height:58vh;min-height:520rpx;max-height:780rpx;overflow:hidden;border-radius:28rpx;background:#fff9ef;box-shadow:inset 0 0 0 1px rgba(90,60,36,.16),0 18rpx 38rpx rgba(64,40,24,.13)}.canvas-base,.canvas-surface{position:absolute;inset:20rpx;width:calc(100% - 40rpx);height:calc(100% - 40rpx)}.canvas-base{pointer-events:none}.canvas-base.line-art{filter:grayscale(1) sepia(.8);opacity:.28}.canvas-base.leather-art{filter:sepia(.7) saturate(.58);opacity:.64}.canvas-base.color-art{filter:grayscale(1) sepia(.45);opacity:.38}.canvas-stage.warn{box-shadow:inset 0 0 0 5rpx rgba(213,166,42,.56),0 18rpx 38rpx rgba(64,40,24,.13)}.canvas-stage.blocked,.canvas-stage.error{box-shadow:inset 0 0 0 6rpx rgba(166,43,35,.7),0 18rpx 38rpx rgba(64,40,24,.13)}
