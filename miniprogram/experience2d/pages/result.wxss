.result-stage{position:relative;height:calc(100vh - 180rpx - env(safe-area-inset-bottom));min-height:900rpx;display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:32rpx;background:#2d1a10;box-shadow:0 22rpx 46rpx rgba(62,39,23,.22)}.result-backdrop{position:absolute;inset:0;width:100%;height:100%;filter:brightness(.72) sepia(.15)}.result-light{position:absolute;width:76%;height:84%;border-radius:48%;background:rgba(255,234,169,.46);filter:blur(26rpx);animation:lightPulse 2.4s ease-in-out infinite}.result-puppet{position:relative;width:72%;height:88%;filter:drop-shadow(0 18rpx 20rpx rgba(45,23,11,.25));animation:resultEnter .8s ease-out both}@keyframes resultEnter{from{opacity:0;transform:scale(.9)}to{opacity:1;transform:scale(1)}}@keyframes lightPulse{50%{opacity:.72;transform:scale(1.04)}}
