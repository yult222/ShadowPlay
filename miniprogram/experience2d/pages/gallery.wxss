.gallery-list{display:grid;grid-template-columns:repeat(2,1fr);gap:18rpx}.gallery-item{position:relative;height:300rpx;display:flex;align-items:flex-end;justify-content:center;overflow:hidden;border-radius:24rpx;background:#e5d2b4}.gallery-item image{position:absolute;inset:0;width:100%;height:100%;padding:14rpx}.gallery-item.leather image{padding:0}.gallery-item.draft image,.gallery-item.trace image{filter:grayscale(1) sepia(.8);opacity:.58}.gallery-item.carve image{filter:sepia(.8) saturate(.5)}.gallery-item.parts image{transform:scale(.86)}.gallery-item.light image{filter:brightness(0);opacity:.82}.gallery-shade{position:absolute;inset:46% 0 0;background:linear-gradient(transparent,rgba(40,23,13,.86))}.gallery-item text{position:relative;z-index:2;padding-bottom:20rpx;color:#fff;font-size:29rpx;font-weight:650}.gallery-item:last-child{grid-column:1/3}
