.role-primary{position:relative;width:100%;height:42vh;min-height:520rpx;max-height:640rpx;display:flex;align-items:flex-end;justify-content:center;overflow:hidden;margin:0;padding:0;border-radius:30rpx;background:#ead8ba;box-shadow:0 18rpx 44rpx rgba(69,43,25,.13)}
.role-paper{position:absolute;inset:0;background:radial-gradient(circle at 50% 36%,#fff8e8 0,#ead2aa 72%,#b78b5f)}
.role-primary image{position:absolute;inset:22rpx 40rpx 76rpx;width:calc(100% - 80rpx);height:calc(100% - 98rpx);filter:drop-shadow(0 16rpx 18rpx rgba(60,35,21,.2));animation:roleEnter .7s ease-out both}
.role-primary.selected{box-shadow:0 0 0 4rpx #a62b23,0 18rpx 44rpx rgba(69,43,25,.16)}
.role-name{position:relative;z-index:3;width:100%;height:72rpx;display:flex;align-items:center;justify-content:center;color:#fff;font-size:32rpx;font-weight:650;background:rgba(66,39,23,.86)}
.role-locked-row{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin:24rpx 0}
.role-locked{position:relative;height:220rpx;overflow:hidden;border-radius:24rpx;background:#dfcfb5}
.role-locked image{width:100%;height:100%;filter:grayscale(1) sepia(.28)}
.role-lock-shade{position:absolute;inset:0;background:linear-gradient(transparent 30%,rgba(46,30,20,.82))}
.role-lock-copy{position:absolute;left:0;right:0;bottom:18rpx;display:flex;align-items:flex-end;justify-content:space-between;padding:0 18rpx;color:#fff;font-size:28rpx;font-weight:600}
.role-lock-copy text:last-child{font-size:28rpx;font-weight:400}
.role-detail{padding:24rpx 4rpx;border-top:1px solid #d7c3a9;border-bottom:1px solid #d7c3a9;font-size:28rpx;line-height:1.9}
.role-detail-title{margin-bottom:4rpx;font-size:31rpx;font-weight:650}
.role-action{position:fixed;z-index:70;left:21%;right:21%;bottom:calc(24rpx + env(safe-area-inset-bottom));width:auto;margin:0;filter:drop-shadow(0 10rpx 18rpx rgba(47,25,13,.24))}
@keyframes roleEnter{from{opacity:0;transform:translateY(18rpx) scale(.98)}to{opacity:1;transform:none}}@media (prefers-reduced-motion:reduce){.role-primary image{animation:none}}
