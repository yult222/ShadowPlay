.stage-panel{padding-top:24rpx}.stage-hint{min-height:48rpx;margin-bottom:16rpx;text-align:center;font-size:28rpx;color:#684630}.draft-board{position:relative;width:100%;height:62vh;min-height:540rpx;max-height:800rpx;overflow:hidden;border-radius:28rpx;background:#fff9ef;box-shadow:inset 0 0 0 1px rgba(90,60,36,.16),0 18rpx 38rpx rgba(64,40,24,.13)}.draft-anchor{position:absolute;inset:24rpx;width:calc(100% - 48rpx);height:calc(100% - 48rpx);filter:grayscale(1) sepia(.8);opacity:.22}.draft-node{position:absolute;z-index:5;width:30px;height:30px;min-height:30px;padding:0;border-radius:50%;background:#d8c4aa;border:2px solid #5a3c24}.draft-node.active{background:#a62b23;animation:pulse 1.1s ease-in-out infinite}.draft-node.done{background:#5a3c24}.draft-reveal{position:absolute;z-index:2;left:14%;right:14%;background:rgba(99,62,36,.08);pointer-events:none}.palette{display:flex;justify-content:center;gap:12rpx;margin-bottom:16rpx}.color-chip{width:76rpx;min-width:44px;height:44px;min-height:44px;padding:0;border-radius:999rpx;color:#fff;font-size:25rpx;box-shadow:inset 0 0 0 2rpx rgba(255,255,255,.44)}.color-chip.active{transform:translateY(-4rpx);box-shadow:0 8rpx 18rpx rgba(54,32,19,.26),inset 0 0 0 3rpx #fff}.region-outline{position:absolute;z-index:4;border:1px solid rgba(90,60,36,.24);border-radius:50%;pointer-events:none}.region-outline.filled{border-color:rgba(90,60,36,.62)}.region-outline.recommended{border-color:#d5a62a;box-shadow:0 0 0 7rpx rgba(213,166,42,.30);animation:pulse 1s infinite}.color-result{position:relative;height:60vh;min-height:560rpx;display:grid;grid-template-columns:1fr 1fr;align-items:center;border-radius:28rpx;background:#fff9ef}.color-result image{width:100%;height:76%}.color-result .before{filter:grayscale(1) sepia(.7);opacity:.34}.rating{position:absolute;left:0;right:0;bottom:24rpx;display:flex;justify-content:center;gap:18rpx}.rating view{width:28rpx;height:28rpx;transform:rotate(45deg);background:#d5a62a;box-shadow:0 0 0 5rpx rgba(213,166,42,.16)}@keyframes pulse{50%{transform:scale(1.12);box-shadow:0 0 0 10rpx rgba(166,43,35,.12)}}
