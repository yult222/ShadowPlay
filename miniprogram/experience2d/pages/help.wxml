<experience-shell title="{{copy.help}}" showBack="{{true}}" backLabel="{{copy.back}}" bind:back="back">
  <view class="help-flow"><view wx:for="{{stages}}" wx:key="id" class="help-step" aria-label="{{item.title}}"><image src="{{item.art}}" mode="aspectFit" aria-role="image" aria-label="{{item.title}}" /><view class="gesture {{item.gesture}}" aria-hidden="true"><view class="gesture-ring"></view><view class="gesture-dot"></view></view><text>{{item.title}}</text></view></view>
</experience-shell>
