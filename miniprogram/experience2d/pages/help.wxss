.help-flow{display:flex;flex-direction:column}.help-step{position:relative;min-height:132rpx;display:grid;grid-template-columns:96rpx 80rpx 1fr;align-items:center;gap:20rpx;border-bottom:1px solid #d6c0a4;font-size:30rpx;color:#5a3c24}.help-step image{width:88rpx;height:108rpx}.gesture{position:relative;width:72rpx;height:72rpx}.gesture-ring{position:absolute;inset:8rpx;border:2rpx solid #a62b23;border-radius:50%;opacity:.36}.gesture.drag .gesture-ring{left:31rpx;right:auto;top:4rpx;bottom:4rpx;width:8rpx;border:0;border-radius:999rpx;background:#a62b23;opacity:.20}.gesture-dot{position:absolute;left:27rpx;top:27rpx;width:18rpx;height:18rpx;border-radius:50%;background:#a62b23}.gesture.tap .gesture-dot{animation:tap 1.4s ease-in-out infinite}.gesture.drag .gesture-dot{animation:drag 1.8s ease-in-out infinite}@keyframes tap{50%{transform:scale(.55);opacity:.55}}@keyframes drag{0%,100%{transform:translateY(14rpx)}50%{transform:translateY(-14rpx)}}@media (prefers-reduced-motion:reduce){.gesture-dot{animation:none!important}}
