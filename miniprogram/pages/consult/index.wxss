.consult-page {
  padding-bottom: 240rpx;
}

.hero-card {
  padding: 0;
  overflow: hidden;
}

.hero-swiper {
  width: 100%;
  height: 360rpx;
}

.hero-slide {
  position: relative;
  width: 100%;
  height: 100%;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(
    to top,
    rgba(15, 8, 4, 0.62) 0%,
    rgba(15, 8, 4, 0.18) 58%,
    rgba(15, 8, 4, 0) 100%
  );
}

.hero-content {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 26rpx;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.9);
}

.headline-item {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.headline-main {
  flex: 1;
  min-width: 0;
  padding-top: 2rpx;
}

.headline-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  color: #2f2318;
}

.headline-summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #715b48;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.headline-cover {
  width: 190rpx;
  height: 136rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  background: #e2d3c3;
}
