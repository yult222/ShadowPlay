.article-page {
  padding-bottom: 240rpx;
}

.article-card {
  padding-bottom: 28rpx;
}

.article-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #2f2419;
}

.article-cover {
  margin-top: 16rpx;
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  background: #e4d5c5;
}

.article-summary {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6e5948;
}

.article-body {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1px solid #e5d6c6;
  font-size: 28rpx;
  line-height: 1.8;
  color: #3d2d20;
}
