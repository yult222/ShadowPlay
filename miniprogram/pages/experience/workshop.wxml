<experience-shell title="{{copy.workshopTitle}}" showBack="{{true}}" backLabel="{{copy.back}}" bind:back="back">
  <view class="workshop-figure"><image src="../../images/experience-v2/xiaodan-anchor.webp" mode="aspectFit" /></view>
  <view class="progress-head"><text>{{copy.currentProgress}}</text><text>{{progress}}%</text></view>
  <experience-progress value="{{progress}}" />
  <view class="process-wrap"><experience-process stages="{{stageViews}}" bind:stage="enterStage" /></view>
  <view class="workshop-status">
    <view><text>{{copy.currentStage}}</text><text>{{activeTitle}}</text></view>
    <view><text>{{copy.completedStage}}</text><text>{{completedTitle}}</text></view>
  </view>
  <button wx:if="{{progress < 100}}" class="primary-action" data-id="{{activeId}}" bindtap="enterStage">{{copy.enterStage}}</button>
</experience-shell>
