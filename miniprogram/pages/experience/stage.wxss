.stage-panel{padding-top:26rpx}.stage-task,.stage-hint{min-height:54rpx;margin-bottom:18rpx;text-align:center;font-size:25rpx;color:#6c4b35}.interaction-board{position:relative;overflow:hidden;margin:0 auto;border-radius:24rpx;background:#fff9f0;box-shadow:inset 0 0 0 1px rgba(90,60,36,.16),0 18rpx 34rpx rgba(64,40,24,.12)}.anchor-image{position:absolute;inset:20px;width:280px;height:380px;pointer-events:none}.line-art{filter:grayscale(1) sepia(.7);opacity:.22}.leather-art{filter:sepia(.66) saturate(.62);opacity:.68}.material-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-top:24rpx}.material{height:246rpx;padding:14rpx;border-radius:22rpx;color:#5a3c24;font-size:25rpx;background:#fff9f0;border:1px solid #d6c2aa}.material-surface{height:164rpx;margin-bottom:12rpx;border-radius:14rpx;background:linear-gradient(135deg,#e0c78f,#f2dfae 48%,#c8a66d)}.material.damaged .material-surface{background:linear-gradient(35deg,#d5b77a 0 42%,#6d4630 43% 48%,#e2c68d 49%)}.material.uneven .material-surface{background:repeating-radial-gradient(ellipse at 30% 60%,#d5b279 0 10rpx,#ead4a4 12rpx 30rpx)}.material.opaque .material-surface{background:#806349}.material.selected,.material.revealed{border-color:#a62b23;box-shadow:0 0 0 4rpx rgba(166,43,35,.12)}.material-feedback{margin-top:28rpx;text-align:center;color:#a62b23;font-size:27rpx}.draft-node{position:absolute;z-index:4;width:26px;height:26px;padding:0;border-radius:50%;background:#d8c4aa;border:2px solid #5a3c24}.draft-node.active{background:#a62b23;animation:pulse 1.1s ease-in-out infinite}.draft-node.done{background:#5a3c24}.path-line,.carve-line{position:absolute;z-index:3;height:4px;transform-origin:0 50%;border-radius:999px;background:#d6c4ae}.path-line.active{background:#bc994f;box-shadow:0 0 0 7px rgba(188,153,79,.16)}.path-line.done{background:#4f3423}.trace-board.warn .path-line.active{background:#d3a72a}.trace-board.blocked .path-line.active{background:#a62b23}.carve-line{height:3px;background:rgba(90,60,36,.25)}.carve-line.active{height:5px;background:#5a3c24;box-shadow:0 0 0 8px rgba(90,60,36,.1)}.carve-line.done{background:#a62b23}.carve-board.error{box-shadow:inset 0 0 0 5rpx #a62b23}.palette{display:flex;justify-content:center;gap:12rpx;margin-bottom:18rpx}.color-chip{width:76rpx;height:64rpx;padding:0;line-height:64rpx;border-radius:999rpx;color:#fff;font-size:23rpx;box-shadow:inset 0 0 0 2rpx rgba(255,255,255,.45)}.color-chip.active{transform:translateY(-5rpx);box-shadow:0 8rpx 18rpx rgba(54,32,19,.26),inset 0 0 0 3rpx #fff}.color-base{filter:grayscale(1) sepia(.65);opacity:.56}.color-region{position:absolute;z-index:5;padding:0;border-radius:50%;border:2px solid rgba(90,60,36,.4)}.color-region.recommended{box-shadow:0 0 0 7rpx rgba(213,166,42,.36);animation:pulse 1s infinite}.color-board.boundary{box-shadow:inset 0 0 0 6rpx rgba(166,43,35,.56)}.color-result{position:relative;height:450rpx;display:grid;grid-template-columns:1fr 1fr;align-items:center;border-radius:24rpx;background:#fff9f0}.color-result image{width:100%;height:360rpx}.rating{position:absolute;left:0;right:0;bottom:20rpx;display:flex;justify-content:center;gap:18rpx}.rating view{width:28rpx;height:28rpx;transform:rotate(45deg);background:#d5a62a;box-shadow:0 0 0 5rpx rgba(213,166,42,.16)}.part-piece{position:absolute;z-index:5;width:32px;height:42px;padding:0;border-radius:10rpx;background:#fff;border:2rpx solid #cdb89f;box-shadow:0 7rpx 16rpx rgba(60,37,22,.14)}.part-piece.active{border-color:#a62b23;animation:pulse 1s infinite}.part-piece.done{opacity:0;transform:translateY(-30rpx) scale(.7);transition:.35s}.drag-backdrop{position:absolute;left:65px;top:40px;width:190px;height:330px;opacity:.22}.lamp-glow{position:absolute;left:74px;top:28px;width:172px;height:360px;border-radius:48%;background:radial-gradient(circle,#ffe9a8,#c08a49 58%,#4d3020);box-shadow:0 0 50px rgba(255,213,116,.32)}.light-shadow{position:absolute;left:105px;top:64px;width:110px;height:282px;filter:brightness(0);opacity:.88}@keyframes pulse{50%{transform:scale(1.16);box-shadow:0 0 0 10rpx rgba(166,43,35,.12)}}
