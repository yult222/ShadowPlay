.result-page{position:relative;min-height:100vh;padding:calc(34rpx + env(safe-area-inset-top)) 28rpx calc(34rpx + env(safe-area-inset-bottom));background:#f4efe6}.result-title{position:absolute;z-index:4;top:calc(34rpx + env(safe-area-inset-top));left:0;right:0;text-align:center;color:#4f3423;font-size:32rpx;font-weight:600;letter-spacing:2rpx}.result-stage{position:relative;height:calc(100vh - 68rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:34rpx;background:radial-gradient(circle at 50% 40%,#ffe7a7 0,#d8ad65 38%,#563725 100%);box-shadow:0 22rpx 46rpx rgba(62,39,23,.22)}.result-light{position:absolute;width:420rpx;height:620rpx;border-radius:50%;background:rgba(255,245,205,.5);filter:blur(24rpx);animation:lightPulse 2.4s ease-in-out infinite}.result-stage image{position:relative;width:520rpx;height:730rpx;filter:brightness(0);animation:resultEnter .8s ease-out both}@keyframes resultEnter{from{opacity:0;transform:scale(.9)}to{opacity:.9;transform:scale(1)}}@keyframes lightPulse{50%{opacity:.72;transform:scale(1.04)}}
