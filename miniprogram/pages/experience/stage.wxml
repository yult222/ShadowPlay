<experience-shell title="{{stageTitle}}" showBack="{{true}}" backLabel="{{copy.back}}" bind:back="back">
  <experience-progress value="{{progress}}" />

  <view wx:if="{{stageId === 'leather'}}" class="stage-panel leather-panel">
    <view class="stage-task">{{copy.leatherTask}}</view>
    <view class="material-grid">
      <button wx:for="{{materials}}" wx:key="id" data-id="{{item.id}}" class="material {{item.className}} {{materialSelected === item.id ? 'selected' : ''}} {{revealCorrect && item.id === 'B' ? 'revealed' : ''}}" bindtap="selectMaterial">
        <view class="material-surface"></view><text>{{item.label}}</text>
      </button>
    </view>
    <view wx:if="{{materialFeedback}}" class="material-feedback">{{materialFeedback}}</view>
  </view>

  <view wx:elif="{{stageId === 'draft'}}" class="stage-panel">
    <view class="interaction-board draft-board" style="width:{{boardWidth}}px;height:{{boardHeight}}px">
      <image class="anchor-image line-art" src="{{anchorImage}}" mode="aspectFit" />
      <view wx:for="{{draftSegments}}" wx:key="id" class="path-line {{item.state}}" style="{{item.style}}"></view>
      <button wx:for="{{draftNodes}}" wx:key="id" class="draft-node {{item.done ? 'done' : ''}} {{index === draftIndex ? 'active' : ''}}" data-index="{{index}}" style="left:{{item.x - 13}}px;top:{{item.y - 13}}px" bindtap="tapDraftNode"></button>
    </view>
  </view>

  <view wx:elif="{{stageId === 'trace'}}" class="stage-panel">
    <view class="stage-hint">{{traceAlert}}</view>
    <view class="interaction-board trace-board {{traceTone}}" style="width:{{boardWidth}}px;height:{{boardHeight}}px" catchtouchstart="traceStart" catchtouchmove="traceMove" catchtouchend="traceEnd">
      <image class="anchor-image line-art" src="{{anchorImage}}" mode="aspectFit" />
      <view wx:for="{{traceSegments}}" wx:key="id" class="path-line {{item.state}}" style="{{item.style}}"></view>
    </view>
  </view>

  <view wx:elif="{{stageId === 'carve'}}" class="stage-panel">
    <view class="stage-hint">{{copy.carveHint}}</view>
    <view class="interaction-board carve-board {{carveError ? 'error' : ''}}" style="width:{{boardWidth}}px;height:{{boardHeight}}px" catchtouchstart="carveStart" catchtouchend="carveEnd">
      <image class="anchor-image leather-art" src="{{anchorImage}}" mode="aspectFit" />
      <view wx:for="{{carveSegments}}" wx:key="id" class="carve-line {{item.state}}" style="{{item.style}}"></view>
    </view>
  </view>

  <view wx:elif="{{stageId === 'color'}}" class="stage-panel color-panel">
    <view class="stage-hint">{{copy.colorHint}}</view>
    <view class="palette"><button wx:for="{{colors}}" wx:key="id" data-id="{{item.id}}" class="color-chip {{selectedColor === item.id ? 'active' : ''}}" style="background:{{item.value}}" bindtap="selectColor">{{item.label}}</button></view>
    <view wx:if="{{!showColorResult}}" class="interaction-board color-board {{boundaryFlash ? 'boundary' : ''}}" style="width:{{boardWidth}}px;height:{{boardHeight}}px" bindtap="flashBoundary">
      <image class="anchor-image color-base" src="{{anchorImage}}" mode="aspectFit" />
      <button wx:for="{{colorRegions}}" wx:key="id" class="color-region {{item.filled ? 'filled' : ''}} {{item.recommended ? 'recommended' : ''}}" data-index="{{index}}" style="left:{{item.x - item.size / 2}}px;top:{{item.y - item.size / 2}}px;width:{{item.size}}px;height:{{item.size}}px;background:{{item.filled ? item.fillValue : 'rgba(255,255,255,.12)'}}" catchtap="fillRegion"></button>
    </view>
    <view wx:else class="color-result"><image class="line-art" src="{{anchorImage}}" mode="aspectFit" /><image src="{{anchorImage}}" mode="aspectFit" /><view class="rating"><view></view><view></view><view></view></view></view>
  </view>

  <view wx:elif="{{stageId === 'parts'}}" class="stage-panel">
    <view class="interaction-board parts-board" style="width:{{boardWidth}}px;height:{{boardHeight}}px">
      <image class="anchor-image line-art" src="{{anchorImage}}" mode="aspectFit" />
      <button wx:for="{{parts}}" wx:key="id" class="part-piece {{item.done ? 'done' : ''}} {{index === partIndex ? 'active' : ''}}" data-index="{{index}}" style="left:{{item.x}}px;top:{{item.y}}px" bindtap="tapPart"></button>
    </view>
  </view>

  <view wx:elif="{{stageId === 'joint'}}" class="stage-panel">
    <view class="stage-hint">{{copy.jointHint}}</view>
    <drag-snap-stage items="{{dragItems}}" targets="{{dragTargets}}" width="{{boardWidth}}" height="{{boardHeight}}" tolerance="{{dragTolerance}}" bind:snap="dragSnap" bind:complete="dragComplete">
      <image class="drag-backdrop line-art" src="{{anchorImage}}" mode="aspectFit" />
    </drag-snap-stage>
  </view>

  <view wx:elif="{{stageId === 'rods'}}" class="stage-panel">
    <drag-snap-stage items="{{dragItems}}" targets="{{dragTargets}}" width="{{boardWidth}}" height="{{boardHeight}}" tolerance="{{dragTolerance}}" bind:snap="dragSnap" bind:complete="dragComplete">
      <image class="drag-backdrop" src="{{anchorImage}}" mode="aspectFit" />
    </drag-snap-stage>
  </view>

  <view wx:elif="{{stageId === 'light'}}" class="stage-panel light-panel">
    <drag-snap-stage items="{{dragItems}}" targets="{{dragTargets}}" width="{{boardWidth}}" height="{{boardHeight}}" tolerance="{{dragTolerance}}" bind:snap="dragSnap" bind:complete="dragComplete">
      <view class="lamp-glow"></view>
      <image wx:if="{{lightSilhouette}}" class="light-shadow" src="{{anchorImage}}" mode="aspectFit" />
    </drag-snap-stage>
  </view>
</experience-shell>
