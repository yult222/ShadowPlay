.entry-stage{position:relative;height:100vh;min-height:1040rpx;overflow:hidden;background:#2b190f}.entry-image{position:absolute;inset:0;width:100%;height:100%;animation:heroEnter .9s ease-out both}.entry-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(34,20,12,.22) 12%,rgba(34,20,12,.05) 42%,rgba(34,20,12,.82) 76%,rgba(24,13,8,.96))}.entry-copy{position:absolute;left:44rpx;right:44rpx;bottom:calc(48rpx + env(safe-area-inset-bottom));z-index:3;animation:copyEnter .72s .14s ease-out both}.entry-subtitle{margin-bottom:30rpx;color:#fff5e7;font-size:34rpx;font-weight:600;letter-spacing:6rpx;text-align:center;text-shadow:0 4rpx 20rpx rgba(24,13,8,.76)}.entry-actions{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.entry-primary,.entry-secondary{display:flex;align-items:center;justify-content:center;min-height:48px;margin:0;padding:0 24rpx;border-radius:999rpx;font-size:30rpx;font-weight:600;line-height:1}.entry-primary{grid-column:1/3;color:#fff;background:#b62d24;box-shadow:0 16rpx 34rpx rgba(86,20,16,.38)}.entry-secondary{color:#fff6e9;border:1px solid rgba(255,245,231,.64);background:rgba(39,23,14,.62);backdrop-filter:blur(14rpx)}@keyframes heroEnter{from{opacity:.35;transform:scale(1.035)}to{opacity:1;transform:scale(1)}}@keyframes copyEnter{from{opacity:0;transform:translateY(24rpx)}to{opacity:1;transform:translateY(0)}}
