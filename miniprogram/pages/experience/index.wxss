.entry-stage{position:relative;height:100vh;min-height:1040rpx;overflow:hidden;background:#2b190f}.entry-image{position:absolute;inset:0;width:100%;height:100%;animation:heroEnter .9s ease-out both}.entry-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(34,20,12,.22) 12%,rgba(34,20,12,.05) 42%,rgba(34,20,12,.82) 76%,rgba(24,13,8,.96))}.entry-copy{position:absolute;left:44rpx;right:44rpx;bottom:calc(48rpx + env(safe-area-inset-bottom));z-index:3;animation:copyEnter .72s .14s ease-out both}.entry-subtitle{margin-bottom:30rpx;color:#fff5e7;font-size:34rpx;font-weight:600;letter-spacing:6rpx;text-align:center;text-shadow:0 4rpx 20rpx rgba(24,13,8,.76)}.entry-actions{display:flex;flex-direction:column;align-items:center;gap:18rpx}.entry-primary{width:64%}.entry-secondary-row{width:82%;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14rpx}.entry-secondary-tag{min-width:0;height:48px;display:flex;align-items:center;justify-content:center;color:#f9ead7;font-size:30rpx;font-weight:650;letter-spacing:2rpx;border-radius:24rpx;background:rgba(54,31,18,.72);box-shadow:inset 0 0 0 1px rgba(244,220,188,.52),0 8rpx 18rpx rgba(31,17,9,.18)}@keyframes heroEnter{from{opacity:.35;transform:scale(1.035)}to{opacity:1;transform:scale(1)}}@keyframes copyEnter{from{opacity:0;transform:translateY(24rpx)}to{opacity:1;transform:translateY(0)}}@media (prefers-reduced-motion:reduce){.entry-image,.entry-copy{animation:none}}
