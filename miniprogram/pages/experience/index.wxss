.entry-stage{position:relative;min-height:100vh;overflow:hidden;background:#2d1c12}.entry-image{position:absolute;inset:0;width:100%;height:100%;animation:heroEnter .9s ease-out both}.entry-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(35,21,13,.28) 16%,rgba(35,21,13,.16) 30%,rgba(35,21,13,.78) 76%,rgba(35,21,13,.94))}.entry-settings{position:absolute;z-index:8;left:22rpx;top:calc(20rpx + env(safe-area-inset-top));height:64rpx;padding:0 24rpx;line-height:64rpx;color:#fff;font-size:25rpx;border-radius:999rpx;background:rgba(45,28,17,.5)}.entry-heading{position:absolute;z-index:7;left:130rpx;right:130rpx;top:calc(32rpx + env(safe-area-inset-top));text-align:center;color:#fff;font-size:30rpx;font-weight:600;letter-spacing:2rpx;text-shadow:0 2rpx 8rpx rgba(38,22,13,.7)}.entry-copy{position:absolute;left:42rpx;right:42rpx;bottom:calc(118rpx + env(safe-area-inset-bottom));z-index:2;animation:copyEnter .72s .16s ease-out both}.entry-subtitle{margin-bottom:34rpx;color:#fff6e9;font-size:34rpx;font-weight:500;letter-spacing:6rpx;text-align:center;text-shadow:0 4rpx 18rpx rgba(24,13,8,.6)}.entry-actions{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.entry-primary,.entry-secondary{height:88rpx;line-height:88rpx;border-radius:999rpx;font-size:28rpx}.entry-primary{grid-column:1/3;color:#fff;background:#a62b23;box-shadow:0 14rpx 30rpx rgba(86,20,16,.34)}.entry-secondary{color:#fff5e7;border:1px solid rgba(255,245,231,.55);background:rgba(41,25,15,.52);backdrop-filter:blur(12rpx)}.paper-pattern{position:absolute;left:0;right:0;bottom:0;height:46rpx;opacity:.4;background:repeating-linear-gradient(90deg,transparent 0 24rpx,#d8b066 24rpx 28rpx,transparent 28rpx 52rpx)}@keyframes heroEnter{from{opacity:.3;transform:scale(1.045)}to{opacity:1;transform:scale(1)}}@keyframes copyEnter{from{opacity:0;transform:translateY(28rpx)}to{opacity:1;transform:translateY(0)}}
