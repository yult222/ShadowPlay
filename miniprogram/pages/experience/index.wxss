.stage-container {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stage-frame {
  position: relative;
  overflow: hidden;
  border-radius: 12px;
}

.stage-layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.highlight-canvas {
  position: absolute;
  left: 0;
  top: 0;
}

.stage-tips {
  margin-top: 12px;
  color: #fff;
  font-size: 14px;
  opacity: 0.9;
  text-align: center;
  max-width: 320px;
}

/* 触摸层盖在舞台上方 */
.touch-area {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  z-index: 50;
  background: rgba(0, 0, 0, 0);
}

.base-layer { z-index: 1; }
.overlay-layer { z-index: 2; }
.highlight-layer { z-index: 3; }

/* ======== 成品页居中修正 ======== */
.finished-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.finished-display {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-top: 12px;
  margin-bottom: 12px;
}

.finished-controls {
  width: 100%;
  display: flex;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
}

.finished-footer {
  width: 100%;
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 10px;
}