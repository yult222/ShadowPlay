.gallery-list{display:grid;grid-template-columns:repeat(3,1fr);gap:18rpx}.gallery-item{height:244rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;border-bottom:1px solid #d9c7b2;color:#5a3c24;font-size:24rpx}.gallery-item image{width:116rpx;height:164rpx;margin-bottom:8rpx}.gallery-item:nth-child(3n+2) image{filter:sepia(.7) saturate(.6)}.gallery-item:nth-child(3n) image{filter:brightness(0);opacity:.78}
