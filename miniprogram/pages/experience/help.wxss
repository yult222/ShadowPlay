.help-flow{display:flex;flex-direction:column}.help-step{min-height:112rpx;display:flex;align-items:center;gap:28rpx;border-bottom:1px solid #dbcbb8;font-size:28rpx;color:#5a3c24}.gesture{position:relative;width:72rpx;height:72rpx}.gesture-ring{position:absolute;inset:8rpx;border:2rpx solid #a62b23;border-radius:50%;opacity:.28}.gesture-dot{position:absolute;left:28rpx;top:28rpx;width:18rpx;height:18rpx;border-radius:50%;background:#a62b23;animation:gesture 1.8s ease-in-out infinite}@keyframes gesture{0%,100%{transform:translate(-9rpx,8rpx)}50%{transform:translate(12rpx,-8rpx)}}
