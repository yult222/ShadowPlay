<experience-shell fullBleed="{{true}}" title="{{copy.entryTitle}}" showSettings="{{true}}" settingsLabel="{{copy.settings}}" bind:settings="openSettings">
  <view class="entry-stage">
    <image class="entry-image" src="../../images/experience-v3/entry-hero.webp" mode="aspectFill" />
    <view class="entry-shade"></view>
    <view class="entry-copy">
      <view class="entry-subtitle">{{copy.entrySubtitle}}</view>
      <view class="entry-actions">
        <button class="entry-primary" bindtap="start">{{copy.start}}</button>
        <button class="entry-secondary" bindtap="openGallery">{{copy.gallery}}</button>
        <button class="entry-secondary" bindtap="openHelp">{{copy.help}}</button>
      </view>
    </view>
  </view>
</experience-shell>
<common-popup visible="{{settingsVisible}}" title="{{copy.settings}}" sfxLabel="{{copy.soundEffects}}" bgmLabel="{{copy.backgroundMusic}}" sfxEnabled="{{sfxEnabled}}" bgmEnabled="{{bgmEnabled}}" bind:close="closeSettings" bind:sfx="changeSfx" bind:bgm="changeBgm" />
