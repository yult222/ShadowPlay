.role-visual{height:410rpx;display:flex;justify-content:center;animation:roleEnter .7s ease-out both}.role-visual image{width:330rpx;height:410rpx}.role-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin:20rpx 0 34rpx}.role-card{min-height:104rpx;padding:14rpx 8rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:16rpx;font-size:21rpx;line-height:1.35;color:#5a3c24;border:1px solid #d7c2aa;background:#fff9f0}.role-card.active{color:#fff;background:#5a3c24}.role-card.locked{opacity:.46}.role-card text+text{margin-top:8rpx;font-size:19rpx}.role-detail{padding:28rpx 4rpx;border-top:1px solid #dbcbb8;border-bottom:1px solid #dbcbb8;font-size:27rpx;line-height:1.9}.role-detail-title{margin-bottom:6rpx;font-size:30rpx;font-weight:600}.primary-action{width:360rpx;height:84rpx;margin:34rpx auto 0;line-height:84rpx;border-radius:999rpx;color:#fff;font-size:28rpx;background:#a62b23}@keyframes roleEnter{from{opacity:0;transform:translateY(18rpx)}to{opacity:1;transform:translateY(0)}}
