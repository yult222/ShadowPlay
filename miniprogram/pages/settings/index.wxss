.settings-page {
  padding-bottom: 240rpx;
}

.profile-card {
  background: linear-gradient(165deg, #fffdf8 0%, #fbf2e8 100%);
}

.profile-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section-tip {
  font-size: 22rpx;
  color: #8d7866;
}

.profile-row {
  margin-top: 14rpx;
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.avatar-btn {
  position: relative;
  width: 146rpx;
  height: 146rpx;
  padding: 0;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid #e4d0ba;
  background: #f2e5d6;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-badge {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: rgba(51, 35, 23, 0.62);
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.nickname-label {
  font-size: 24rpx;
  color: #7a6654;
}

.nickname-input {
  margin-top: 8rpx;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  border: 1px solid #d7c0a8;
  background: #fff;
  font-size: 28rpx;
  color: #2f2318;
}

.nickname-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8c7868;
}

.favorite-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.tiny {
  min-height: 54rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
}

.favorite-item {
  margin-top: 12rpx;
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.favorite-cover {
  width: 106rpx;
  height: 106rpx;
  border-radius: 12rpx;
  background: #e3d4c4;
}

.favorite-main {
  flex: 1;
  min-width: 0;
}

.favorite-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #302217;
}

.favorite-tags {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
}

.system-card {
  padding-bottom: 24rpx;
}

.setting-row {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.setting-main {
  flex: 1;
  min-width: 0;
}

.setting-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #34261a;
}

.setting-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7d6a58;
}

.divider {
  margin: 16rpx 0 10rpx;
  border-top: 1px dashed #dcc9b5;
}

.about-text {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #6d5847;
}
