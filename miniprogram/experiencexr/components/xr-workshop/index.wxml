<xr-scene id="xr-scene" bind:ready="handleReady" bind:tick="handleTick" bind:error="handleError">
  <xr-assets bind:loaded="handleLoaded">
    <xr-asset-load type="texture" asset-id="workshop-texture" src="/images/experience-v3/workshop.webp" />
    <xr-asset-load type="gltf" asset-id="experience-kit" src="/experiencexr/xr-assets/experience-kit.glb" />
    <xr-asset-material asset-id="workshop-mat" effect="simple" uniforms="u_baseColorMap:workshop-texture" />
    <xr-asset-material asset-id="wood-mat" effect="standard" uniforms="u_baseColorFactor:0.22 0.10 0.045 1" />
    <xr-asset-material asset-id="red-mat" effect="standard" uniforms="u_baseColorFactor:0.55 0.08 0.055 1" />
    <xr-asset-material asset-id="gold-mat" effect="standard" uniforms="u_baseColorFactor:0.62 0.39 0.12 1" />
  </xr-assets>
  <xr-node>
    <xr-mesh node-id="workshop-plane" geometry="plane" scale="3.4 1.92 1" material="workshop-mat" position="0 0 0" />
    <xr-gltf node-id="experience-kit-node" model="experience-kit" position="0 -0.08 0.32" />
    <xr-mesh node-id="progress-pin" geometry="sphere" scale="0.12 0.12 0.12" material="gold-mat" position="{{pinX}} -0.84 0.46" />
    <xr-mesh node-id="red-seal" geometry="cylinder" scale="0.16 0.05 0.16" rotation="90 0 0" material="red-mat" position="0 -0.83 0.43" />
    <xr-camera id="camera" node-id="camera" position="0 0 5.1" clear-color="0 0 0 0" target="workshop-plane" />
  </xr-node>
  <xr-node node-id="lights">
    <xr-light type="ambient" color="1 0.78 0.55" intensity="1.1" />
    <xr-light type="directional" rotation="160 20 0" color="1 0.72 0.42" intensity="2.4" />
  </xr-node>
</xr-scene>
