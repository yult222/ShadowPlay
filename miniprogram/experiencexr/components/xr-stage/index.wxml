<xr-scene id="xr-scene" bind:ready="handleReady" bind:error="handleError">
  <xr-assets bind:loaded="handleLoaded">
    <xr-asset-load type="texture" asset-id="workshop-texture" src="/images/experience-v3/workshop.webp" />
    <xr-asset-load type="texture" asset-id="leather-texture" src="/images/experience-v3/leather-board.webp" />
    <xr-asset-load type="texture" asset-id="puppet-texture" src="/images/experience-v3/xiaodan-anchor.webp" />
    <block wx:for="{{renderParts}}" wx:key="id">
      <xr-asset-load type="texture" asset-id="part-texture-{{index}}" src="{{item.asset}}" />
      <xr-asset-material asset-id="part-mat-{{index}}" effect="simple" uniforms="u_baseColorMap:part-texture-{{index}}" states="alphaMode:BLEND" />
    </block>
    <xr-asset-material asset-id="workshop-mat" effect="simple" uniforms="u_baseColorMap:workshop-texture" />
    <xr-asset-material asset-id="leather-mat" effect="simple" uniforms="u_baseColorMap:leather-texture" />
    <xr-asset-material asset-id="puppet-mat" effect="simple" uniforms="u_baseColorMap:puppet-texture" states="alphaMode:BLEND" />
    <xr-asset-material asset-id="silhouette-mat" effect="simple" uniforms="u_baseColorFactor:0.08 0.035 0.018 0.9" states="alphaMode:BLEND" />
    <xr-asset-material asset-id="wood-mat" effect="standard" uniforms="u_baseColorFactor:0.20 0.085 0.03 1" />
    <xr-asset-material asset-id="gold-mat" effect="standard" uniforms="u_baseColorFactor:0.64 0.40 0.12 1" />
    <xr-asset-material asset-id="red-mat" effect="standard" uniforms="u_baseColorFactor:0.58 0.08 0.055 1" />
  </xr-assets>
  <xr-node>
    <xr-mesh node-id="background" geometry="plane" scale="3.42 1.92 1" material="workshop-mat" position="0 0 -0.35" />
    <xr-mesh wx:if="{{stageId === 'leather'}}" node-id="leather-board" geometry="plane" scale="1.8 1.8 1" material="leather-mat" position="0 0 0.04" bind:drag-shape="handleLeatherDrag" bind:touch-shape="handleLeatherTouch" plane-shape />
    <block wx:if="{{stageId === 'parts' || stageId === 'joint'}}">
      <xr-mesh wx:for="{{renderParts}}" wx:key="id" node-id="part-{{index}}" data-index="{{index}}" geometry="plane" scale="{{item.scale}}" material="part-mat-{{index}}" position="{{item.position}}" visible="{{stageId === 'joint' || !item.fixed}}" bind:touch-shape="handlePartTouch" bind:drag-shape="handlePartDrag" plane-shape />
      <xr-mesh wx:for="{{jointPins}}" wx:key="id" node-id="pin-{{index}}" data-index="{{index}}" geometry="sphere" scale="0.07 0.07 0.07" material="gold-mat" position="{{item.position}}" visible="{{stageId === 'joint' && phase !== 'parts'}}" bind:touch-shape="handlePinTouch" sphere-shape />
    </block>
    <block wx:if="{{stageId === 'rods'}}">
      <xr-mesh node-id="puppet-rods" geometry="plane" scale="0.88 1.38 1" material="puppet-mat" position="0 0 0.05" />
      <xr-mesh wx:for="{{rods}}" wx:key="id" node-id="rod-{{index}}" data-index="{{index}}" geometry="cube" scale="0.035 0.72 0.035" material="wood-mat" position="{{item.position}}" bind:drag-shape="handleRodDrag" cube-shape />
    </block>
    <block wx:if="{{stageId === 'light'}}">
      <xr-mesh node-id="lamp" geometry="plane" scale="1.62 1.62 1" material="silhouette-mat" position="0 0 -0.02" />
      <xr-mesh node-id="light-puppet" geometry="plane" scale="0.72 1.20 1" material="{{completed ? 'silhouette-mat' : 'puppet-mat'}}" position="-1.45 -0.10 0.12" bind:drag-shape="handleLightDrag" plane-shape />
    </block>
    <xr-camera id="camera" node-id="camera" position="0 0 5.2" clear-color="0 0 0 0" target="background" />
  </xr-node>
  <xr-node node-id="lights"><xr-light type="ambient" color="1 0.78 0.58" intensity="1.15" /><xr-light type="directional" rotation="165 30 0" color="1 0.70 0.42" intensity="2.2" /></xr-node>
</xr-scene>
