.workshop-scene{position:relative;height:360rpx;overflow:hidden;border-radius:30rpx;background:#2b1a10;box-shadow:0 20rpx 46rpx rgba(60,37,21,.18)}
.workshop-art-static{display:block;width:100%;height:100%}.workshop-art{position:absolute;z-index:0;left:0;top:0;width:100%;height:100%;display:block}.workshop-scene>xr-workshop{position:absolute;z-index:1;left:0;top:0;width:100%;height:100%;display:block}
.workshop-scene-shade{position:absolute;z-index:2;inset:0;pointer-events:none;background:linear-gradient(180deg,transparent 42%,rgba(31,17,9,.78))}.progress-head{position:absolute;z-index:5;left:26rpx;right:26rpx;bottom:62rpx;display:flex;justify-content:space-between;color:#fff5e8;font-size:28rpx;font-weight:600}.scene-progress{position:absolute;z-index:5;left:26rpx;right:26rpx;bottom:24rpx}
.process-wrap{margin:30rpx 0}.workshop-status{padding:6rpx 0;border-top:1px solid #d7c2a7;border-bottom:1px solid #d7c2a7}.workshop-status>view{display:flex;justify-content:space-between;gap:26rpx;padding:17rpx 0;font-size:26rpx}.workshop-status text:last-child{max-width:58%;text-align:right;color:#7a4931}
.primary-action{width:100%;min-height:48px;margin:30rpx auto 0;display:flex;align-items:center;justify-content:center;border-radius:999rpx;color:#fff;font-size:30rpx;font-weight:650;background:#a62b23}
