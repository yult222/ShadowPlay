.stage-panel{padding-top:24rpx}.stage-task,.stage-hint{min-height:48rpx;margin-bottom:16rpx;text-align:center;font-size:28rpx;color:#684630}
.leather-view{position:relative;height:300rpx;overflow:hidden;border-radius:28rpx;background:#2b190f;box-shadow:0 18rpx 38rpx rgba(62,38,22,.15)}.leather-view>.leather-static{position:static;display:block;width:100%;height:100%}.leather-view>image,.leather-view>xr-stage{position:absolute;left:0;top:0;display:block;width:100%;height:100%}.leather-view>image{z-index:0}.leather-view>xr-stage{z-index:1}
.material-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:20rpx}.material{min-height:164rpx;padding:10rpx;border-radius:20rpx;color:#5a3c24;font-size:27rpx;background:#fff8ed;border:1px solid #d3bfa3}.material-surface{display:block;width:100%;height:108rpx;margin-bottom:8rpx;border-radius:14rpx}.material.selected,.material.revealed{border-color:#a62b23;box-shadow:0 0 0 4rpx rgba(166,43,35,.14)}.material-feedback{margin-top:18rpx;text-align:center;color:#a62b23;font-size:28rpx}
.confirm-action{width:100%;min-height:48px;margin-top:22rpx;display:flex;align-items:center;justify-content:center;border-radius:999rpx;color:#fff;font-size:30rpx;background:#9f8c7d;opacity:.48}.confirm-action.ready{background:#a62b23;opacity:1}
.xr-board{height:62vh;min-height:560rpx;max-height:810rpx;overflow:hidden;border-radius:28rpx;background:#2b190f url('/images/experience-v3/workshop.webp') center/cover;box-shadow:0 18rpx 40rpx rgba(62,38,22,.17)}.xr-board>xr-stage{display:block;width:100%;height:100%}
.parts-fallback{height:100%;display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;padding:18rpx;overflow:auto;background:url('/images/experience-v3/workshop.webp') center/cover}.part-card{min-height:144rpx;padding:8rpx;border-radius:18rpx;background:rgba(255,248,235,.88);border:1px solid rgba(91,58,34,.24)}.part-card image{width:100%;height:128rpx}.part-card.active{box-shadow:0 0 0 4rpx #a62b23}.part-card.done{opacity:.16;transform:scale(.86)}
.drag-backdrop{position:absolute;left:20%;top:9%;width:60%;height:82%;opacity:.38}.drag-backdrop.line-art{filter:grayscale(1) sepia(.7);opacity:.20}.lamp-screen{position:absolute;left:16%;right:16%;top:7%;bottom:7%;border-radius:46%;background:radial-gradient(circle,#fff1ba,#d49d4f 60%,#432719);box-shadow:0 0 70rpx rgba(255,218,123,.35)}.light-shadow{position:absolute;left:33%;top:16%;width:34%;height:68%;filter:brightness(0);opacity:.88}
@keyframes pulse{50%{transform:scale(1.12);box-shadow:0 0 0 10rpx rgba(166,43,35,.12)}}
