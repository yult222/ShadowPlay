<experience-shell title="{{stageTitle}}" showBack="{{true}}" backLabel="{{copy.back}}" bind:back="back">
  <experience-progress value="{{progress}}" />
  <view wx:if="{{stageId === 'leather'}}" class="stage-panel">
    <view class="stage-task">{{copy.leatherTask}}</view>
    <view class="leather-view">
      <image wx:if="{{!xrEnabled}}" class="leather-static" src="/images/experience-v3/leather-board.webp" mode="aspectFill" />
      <block wx:else><image src="/images/experience-v3/leather-board.webp" mode="aspectFill" /><xr-stage stageId="leather" bind:action="xrAction" bind:fallback="xrFallback" /></block>
    </view>
    <view class="material-grid">
      <button wx:for="{{materials}}" wx:key="id" data-id="{{item.id}}" class="material {{materialSelected === item.id ? 'selected' : ''}} {{revealCorrect && item.id === 'B' ? 'revealed' : ''}}" bindtap="selectMaterial">
        <image class="material-surface" src="{{item.asset}}" mode="aspectFill" /><text>{{item.label}}</text>
      </button>
    </view>
    <view wx:if="{{materialFeedback}}" class="material-feedback">{{materialFeedback}}</view>
    <button class="confirm-action {{materialSelected ? 'ready' : ''}}" disabled="{{!materialSelected}}" bindtap="confirmMaterial">{{copy.confirm}}</button>
  </view>
  <view wx:elif="{{stageId === 'parts' || stageId === 'joint' || stageId === 'rods' || stageId === 'light'}}" class="stage-panel xr-panel">
    <view wx:if="{{stageId === 'joint'}}" class="stage-hint">{{copy.jointHint}}</view>
    <view class="xr-board">
      <xr-stage wx:if="{{xrEnabled}}" stageId="{{stageId}}" phase="{{stageId === 'rods' ? rodPhase : jointPhase}}" activeIndex="{{stageId === 'parts' ? partIndex : jointIndex}}" completed="{{xrCompleted}}" bind:action="xrAction" bind:fallback="xrFallback" />
      <view wx:elif="{{stageId === 'parts'}}" class="parts-fallback">
        <button wx:for="{{parts}}" wx:key="id" data-index="{{index}}" class="part-card {{item.done ? 'done' : ''}} {{index === partIndex ? 'active' : ''}}" bindtap="tapFallbackPart"><image src="{{item.asset}}" mode="aspectFit" /></button>
      </view>
      <drag-snap-stage wx:else items="{{fallbackItems}}" targets="{{fallbackTargets}}" width="{{boardWidth}}" height="{{boardHeight}}" tolerance="{{dragTolerance}}" bind:snap="fallbackSnap" bind:complete="fallbackComplete">
        <image wx:if="{{stageId !== 'light'}}" class="drag-backdrop {{stageId === 'joint' ? 'line-art' : ''}}" src="{{anchorImage}}" mode="aspectFit" />
        <view wx:if="{{stageId === 'light'}}" class="lamp-screen"></view>
        <image wx:if="{{stageId === 'light' && xrCompleted}}" class="light-shadow" src="{{anchorImage}}" mode="aspectFit" />
      </drag-snap-stage>
    </view>
  </view>
</experience-shell>
