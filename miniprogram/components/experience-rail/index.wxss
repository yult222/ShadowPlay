.process-rail{position:absolute;z-index:42;left:14rpx;top:18rpx;bottom:20rpx;width:88rpx;overflow:hidden;border-radius:22rpx;background:linear-gradient(180deg,rgba(48,27,15,.90),rgba(32,18,11,.86));box-shadow:inset 0 0 0 1px rgba(238,210,171,.16),0 14rpx 34rpx rgba(22,12,7,.28);backdrop-filter:blur(12rpx);transition:width .22s ease}.process-rail.expanded{width:272rpx}.rail-toggle{position:absolute;z-index:3;right:0;top:0;width:44px;height:44px;display:flex;align-items:center;justify-content:center;color:#efd8b7;font-size:38rpx}.rail-line{position:absolute;left:43rpx;top:92rpx;bottom:76rpx;width:2rpx;background:rgba(222,190,146,.20)}.rail-steps{position:absolute;left:0;right:0;top:84rpx;bottom:70rpx;display:flex;flex-direction:column;justify-content:space-around}.rail-step{position:relative;min-height:44px;display:flex;align-items:center;color:rgba(236,215,184,.32)}.rail-mark{flex:0 0 88rpx;height:44px;display:flex;align-items:center;justify-content:center}.rail-mark>view{width:13rpx;height:13rpx;border-radius:50%;background:currentColor;transition:transform .2s ease,box-shadow .2s ease}.rail-step.completed{color:#d8b67f}.rail-step.completed .rail-mark>view{width:18rpx;height:18rpx;background:#c49a57;box-shadow:inset 0 0 0 4rpx rgba(255,240,209,.22)}.rail-step.active{color:#fff0d5}.rail-step.active .rail-mark>view{width:20rpx;height:20rpx;background:#b73329;box-shadow:0 0 0 9rpx rgba(183,51,41,.18),0 0 22rpx rgba(225,107,81,.56);animation:railPulse 2.4s ease-in-out infinite}.rail-title{white-space:nowrap;font-size:28rpx;letter-spacing:2rpx}.rail-progress{position:absolute;left:0;right:0;bottom:20rpx;text-align:center;color:#f0d7b2;font-size:28rpx;font-weight:600}.expanded .rail-progress{text-align:left;padding-left:102rpx}@keyframes railPulse{50%{transform:scale(1.18);box-shadow:0 0 0 12rpx rgba(183,51,41,.10),0 0 28rpx rgba(225,107,81,.66)}}@media (prefers-reduced-motion:reduce){.process-rail,.rail-mark>view{transition:none}.rail-step.active .rail-mark>view{animation:none}}
