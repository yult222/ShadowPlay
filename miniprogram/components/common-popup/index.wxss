.popup-layer{position:fixed;inset:0;z-index:1000}.popup-backdrop{position:absolute;inset:0;background:rgba(37,24,16,.14)}.popup-sheet{position:absolute;right:24rpx;top:190rpx;width:330rpx;padding:24rpx 26rpx;border:1px solid rgba(90,60,36,.2);border-radius:18rpx;background:#fff8e9;box-shadow:0 18rpx 50rpx rgba(40,24,13,.22);box-sizing:border-box}.popup-title{margin-bottom:12rpx;font-size:28rpx;font-weight:650;text-align:left}.setting-row{min-height:76rpx;display:flex;align-items:center;justify-content:space-between;border-top:1px solid #e7d8c8;font-size:26rpx;color:#30251c}
