.popup-layer{position:fixed;inset:0;z-index:1000}.popup-backdrop{position:absolute;inset:0;background:rgba(37,24,16,.46)}.popup-sheet{position:absolute;left:0;right:0;bottom:0;padding:42rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));border-radius:34rpx 34rpx 0 0;background:#fff9f0;box-shadow:0 -18rpx 50rpx rgba(40,24,13,.2)}.popup-title{margin-bottom:26rpx;font-size:34rpx;font-weight:600;text-align:center}.setting-row{min-height:92rpx;display:flex;align-items:center;justify-content:space-between;border-top:1px solid #e7d8c8;font-size:28rpx;color:#30251c}
