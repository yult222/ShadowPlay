.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;

  background: rgba(0, 0, 0, 0.5);

  display: flex;
  align-items: center;
  justify-content: center;

  z-index: 999;
}

.popup {
  width: 600rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.title {
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.content {
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 40rpx;
}

.buttons {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.buttons button {
  flex: 1;
}
