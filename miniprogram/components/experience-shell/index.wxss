.experience-shell{min-height:100vh;background:#f3eadc;color:#30251c}.experience-header{position:fixed;z-index:80;left:0;right:0;top:0;box-sizing:border-box;border-bottom:1px solid rgba(73,45,28,.14);background:rgba(243,234,220,.96);backdrop-filter:blur(18rpx)}.experience-header-row{position:relative;display:flex;align-items:center;justify-content:center}.header-title{max-width:390rpx;padding:0 12rpx;font-size:32rpx;font-weight:650;letter-spacing:2rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.header-action{position:absolute;left:24rpx;top:0;display:flex;align-items:center;justify-content:center;min-width:88rpx;height:100%;min-height:44px;padding:0 18rpx;color:#5a3c24;font-size:28rpx;line-height:1;background:transparent;border-radius:999rpx}.experience-content{min-height:100vh;padding-left:28rpx;padding-right:28rpx;padding-bottom:calc(150rpx + env(safe-area-inset-bottom));box-sizing:border-box}.full-bleed .experience-header{position:absolute;color:#fff;border-bottom:none;background:linear-gradient(180deg,rgba(33,20,12,.76),rgba(33,20,12,.24) 76%,transparent);backdrop-filter:none}.full-bleed .header-title{text-shadow:0 2rpx 12rpx rgba(30,17,10,.7)}.full-bleed .header-action{color:#fff;background:rgba(45,28,17,.46);height:36px;min-height:36px;top:4px}.full-bleed .experience-content{padding:0;min-height:100vh}
