.experience-shell{min-height:100vh;background:#f4efe6;color:#30251c}.experience-header{position:relative;z-index:30;box-sizing:border-box;height:calc(96rpx + env(safe-area-inset-top));padding-top:env(safe-area-inset-top);display:flex;align-items:center;justify-content:center;border-bottom:1px solid rgba(90,60,36,.16);background:rgba(244,239,230,.94)}.header-title{max-width:430rpx;font-size:32rpx;font-weight:600;letter-spacing:2rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.header-action{position:absolute;left:22rpx;bottom:14rpx;min-width:94rpx;height:64rpx;padding:0 14rpx;line-height:64rpx;font-size:25rpx;color:#5a3c24;background:transparent;border-radius:999rpx}.experience-content{min-height:calc(100vh - 96rpx - env(safe-area-inset-top));padding:28rpx 28rpx calc(156rpx + env(safe-area-inset-bottom))}.full-bleed .experience-header{position:absolute;left:0;right:0;top:0;color:#fff;border-bottom:none;background:linear-gradient(rgba(41,25,15,.82),rgba(41,25,15,.28) 72%,transparent)}.full-bleed .header-title{text-shadow:0 2rpx 8rpx rgba(38,22,13,.7)}.full-bleed .header-action{color:#fff;background:rgba(45,28,17,.38)}.full-bleed .experience-content{padding:0;min-height:100vh}
