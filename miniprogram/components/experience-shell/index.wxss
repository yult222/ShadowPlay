.experience-shell{min-height:100vh;background:#f3eadc;color:#30251c}.experience-header{position:fixed;z-index:80;left:0;right:0;top:0;box-sizing:border-box;border-bottom:1px solid rgba(73,45,28,.14);background:rgba(243,234,220,.96);backdrop-filter:blur(18rpx)}.experience-header-row{position:relative;display:flex;align-items:center;justify-content:center;padding:0 24rpx;box-sizing:border-box}.header-title{max-width:300rpx;padding:0 8rpx;font-size:32rpx;font-weight:650;letter-spacing:2rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.header-action{position:absolute;top:2px;display:flex;align-items:center;justify-content:center;width:96rpx;min-width:96rpx;max-width:96rpx;height:44px;min-height:44px;margin:0;padding:0;color:#5a3c24;font-size:27rpx;line-height:1;background:rgba(255,249,240,.62);border:1px solid rgba(90,60,36,.16);border-radius:12rpx;box-sizing:border-box}.header-action::after{display:none}.header-left{left:24rpx}.header-right{right:24rpx}.experience-content{min-height:100vh;padding-left:28rpx;padding-right:28rpx;padding-bottom:calc(150rpx + env(safe-area-inset-bottom));box-sizing:border-box}.full-bleed .experience-header{position:absolute;color:#fff;border-bottom:none;background:linear-gradient(180deg,rgba(33,20,12,.76),rgba(33,20,12,.24) 76%,transparent);backdrop-filter:none}.full-bleed .header-title{text-shadow:0 2rpx 12rpx rgba(30,17,10,.7)}.full-bleed .header-action{color:#fff;background:rgba(45,28,17,.38);border-color:rgba(255,255,255,.2)}.full-bleed .experience-content{padding:0;min-height:100vh}
