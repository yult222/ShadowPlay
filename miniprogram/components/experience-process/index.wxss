.process-list{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx}.process-step{min-height:48px;padding:18rpx 8rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:18rpx;color:#7d6d60;background:rgba(255,249,240,.72);border:1px solid rgba(90,60,36,.14)}.process-step::after{display:none}.process-step.active{color:#fff;background:#5a3c24;box-shadow:0 14rpx 30rpx rgba(90,60,36,.22)}.process-step.completed{color:#5a3c24;background:#eadcca}.process-step.locked{opacity:.46}.step-mark{width:16rpx;height:16rpx;margin-bottom:10rpx;border-radius:50%;background:currentColor}.completed .step-mark{box-shadow:0 0 0 6rpx rgba(90,60,36,.12)}.step-title{font-size:26rpx;line-height:1.25}
