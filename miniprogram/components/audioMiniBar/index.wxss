.audio-mini-bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(118rpx + env(safe-area-inset-bottom));
  z-index: 999;
  padding: 18rpx 20rpx 20rpx;
  border-radius: 20rpx;
  border: 1px solid #d9c5af;
  background: #fffdf8;
  box-shadow: 0 12rpx 24rpx rgba(52, 32, 17, 0.14);
}

.meta {
  padding-right: 176rpx;
}

.title-line {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 27rpx;
  font-weight: 600;
  color: #322116;
}

.sub-line {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #806d5a;
}

.actions {
  position: absolute;
  right: 20rpx;
  top: 14rpx;
  display: flex;
  gap: 12rpx;
}

.action-btn {
  min-width: 68rpx;
  height: 52rpx;
  padding: 0 16rpx;
  line-height: 52rpx;
  font-size: 23rpx;
  color: #ffffff;
  background: #5a3c24;
  border-radius: 10rpx;
}

.action-btn.stop {
  color: #5a3c24;
  background: #f1e5d7;
}

.progress-track {
  margin-top: 14rpx;
  width: 100%;
  height: 6rpx;
  background: #eadccf;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-value {
  height: 100%;
  border-radius: 999rpx;
  background: #5a3c24;
}
