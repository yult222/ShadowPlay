:host{display:block;width:100%;min-width:0}.experience-button{width:100%;min-width:0;min-height:48px;margin:0;padding:0 28rpx;display:flex;align-items:center;justify-content:center;border:0;border-radius:24rpx;font-size:30rpx;font-weight:650;line-height:1;letter-spacing:2rpx;box-sizing:border-box;transform:translateZ(0);transition:transform .16s ease,filter .16s ease,background .16s ease}.experience-button::after{display:none}.experience-button:active{transform:translateY(2rpx);filter:brightness(.94)}.experience-button.primary{color:#fff7e9;background:linear-gradient(180deg,#bd3a2e,#94241e);box-shadow:inset 0 2rpx rgba(255,255,255,.18),inset 0 -4rpx rgba(79,20,16,.28),0 12rpx 26rpx rgba(65,20,16,.28)}.experience-button.secondary{color:#f9ead7;background:rgba(54,31,18,.72);box-shadow:inset 0 0 0 1px rgba(244,220,188,.52),0 8rpx 18rpx rgba(31,17,9,.18);backdrop-filter:blur(12rpx)}.experience-button.paper{color:#5a3c24;background:#f2e4d0;box-shadow:inset 0 0 0 1px rgba(90,60,36,.22),0 8rpx 18rpx rgba(52,31,18,.12)}.experience-button.is-disabled{opacity:.38;filter:grayscale(.5)}@media (prefers-reduced-motion:reduce){.experience-button{transition:none}}
