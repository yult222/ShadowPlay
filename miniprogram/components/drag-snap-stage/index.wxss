.drag-stage{position:relative;overflow:hidden;margin:0 auto;border-radius:24rpx;background:rgba(255,249,240,.76);box-shadow:inset 0 0 0 1px rgba(90,60,36,.16)}.snap-target{position:absolute;border:2rpx dashed rgba(90,60,36,.32);border-radius:14rpx;background:rgba(255,255,255,.26)}.snap-target.connector{border-radius:50%}.snap-target.rod{border-radius:999rpx}.snap-target.figure{border-radius:44%;background:rgba(255,225,146,.2);box-shadow:0 0 60rpx rgba(255,210,100,.22)}.drag-item{position:absolute;z-index:4;border-radius:12rpx;background:#fff;box-shadow:0 8rpx 18rpx rgba(57,35,21,.18);touch-action:none}.drag-item.connector{border-radius:50%;background:#b48943}.drag-item.rod{border-radius:999rpx;background:#4f321f}.drag-item.figure{background:transparent;box-shadow:none}.drag-item.fixed{box-shadow:none}.drag-image{width:100%;height:100%}.drag-image.silhouette{filter:brightness(0)}
