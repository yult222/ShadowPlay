<xr-scene bind:ready="ready" bind:error="fallback">
  <xr-assets bind:loaded="loaded">
    <xr-asset-load type="texture" asset-id="puppet-texture" src="/images/experience-v3/xiaodan-anchor.webp" />
    <xr-asset-material asset-id="puppet-mat" effect="simple" uniforms="u_baseColorMap:puppet-texture" states="alphaMode:BLEND" />
    <xr-asset-material asset-id="silhouette-mat" effect="simple" uniforms="u_baseColorFactor:0.07 0.03 0.015 0.86" states="alphaMode:BLEND" />
    <xr-asset-material asset-id="wood-mat" effect="standard" uniforms="u_baseColorFactor:0.20 0.085 0.03 1" />
  </xr-assets>
  <xr-node>
    <block wx:if="{{stageId === 'rods'}}">
      <xr-mesh geometry="plane" scale="0.88 1.38 1" material="puppet-mat" position="0 0 0.05" />
      <xr-mesh wx:for="{{rods}}" wx:key="id" data-index="{{index}}" geometry="cube" scale="0.035 0.72 0.035" material="wood-mat" position="{{phase === 'test' ? (index === 0 ? '-0.72 0.30 0.16' : index === 1 ? '0 0.82 0.16' : '0.72 0.30 0.16') : item.position}}" bind:drag-shape="dragRod" cube-shape />
    </block>
    <block wx:if="{{stageId === 'light'}}">
      <xr-mesh geometry="plane" scale="1.62 1.62 1" material="silhouette-mat" position="0 0 -0.02" />
      <xr-mesh geometry="plane" scale="0.72 1.20 1" material="{{completed ? 'silhouette-mat' : 'puppet-mat'}}" position="{{phase === 'puppet' ? '-1.45 -0.10 0.12' : '0 0 0.12'}}" bind:drag-shape="dragLight" plane-shape />
    </block>
    <xr-camera position="0 0 5.2" clear-color="0 0 0 0" />
  </xr-node>
  <xr-node><xr-light type="ambient" color="1 0.78 0.58" intensity="1.15" /><xr-light type="directional" rotation="165 30 0" color="1 0.70 0.42" intensity="2.2" /></xr-node>
</xr-scene>
