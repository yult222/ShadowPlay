.free-drag{position:relative;overflow:hidden;margin:0 auto}.drag-target{position:absolute;border:2rpx dashed rgba(100,61,31,.30);border-radius:20rpx;background:rgba(255,229,177,.11);animation:targetBreath 2.6s ease-in-out infinite}.drag-target.inspect{border-radius:28rpx;background:radial-gradient(circle,rgba(255,238,187,.38),rgba(218,155,70,.08) 64%,transparent);box-shadow:inset 0 0 28rpx rgba(255,213,123,.16)}.drag-target.structure-target{border-radius:18rpx;background:rgba(255,238,199,.08);box-shadow:inset 0 0 20rpx rgba(245,207,139,.08)}.drag-target.trace-target{border-radius:28rpx;background:linear-gradient(135deg,rgba(255,244,214,.15),rgba(219,177,105,.08));box-shadow:inset 0 0 0 2rpx rgba(240,207,148,.12)}.drag-target.separate{border-radius:24rpx;background:rgba(255,225,177,.06)}.drag-target.connector{border-radius:50%}.drag-target.rod{border-radius:999rpx}.drag-target.motion-target{border-style:solid;border-color:rgba(214,169,95,.38)}.drag-target.light{border-radius:44%;background:rgba(255,225,147,.17)}.drag-target.glow{border-color:rgba(213,166,42,.72);box-shadow:0 0 26rpx rgba(213,166,42,.38)}.drag-piece{position:absolute;z-index:4;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:16rpx;touch-action:none;filter:drop-shadow(0 8rpx 10rpx rgba(49,28,15,.28));transition:filter .2s ease,opacity .2s ease}.drag-piece image{width:100%;height:100%}.drag-piece.material{overflow:hidden;background:rgba(61,35,18,.42);box-shadow:inset 0 0 0 1px rgba(255,231,193,.32)}.drag-piece.draft-piece{background:rgba(243,220,179,.10);box-shadow:inset 0 0 0 1px rgba(255,236,202,.14)}.drag-piece.trace-sheet{overflow:hidden;border-radius:18rpx;background:rgba(246,225,184,.82);box-shadow:0 12rpx 30rpx rgba(44,25,13,.32)}.piece-label{position:absolute;left:0;right:0;bottom:3rpx;color:#fff5df;text-align:center;font-size:28rpx;font-weight:600;text-shadow:0 2rpx 8rpx rgba(27,14,7,.92)}.drag-piece.connector{border-radius:50%;background:#b58a43;box-shadow:inset 0 0 0 3rpx #e3bf79}.drag-piece.rod{border-radius:999rpx;background:linear-gradient(90deg,transparent calc(50% - 10px),#2d180c calc(50% - 10px),#6f4424 50%,#2d180c calc(50% + 10px),transparent calc(50% + 10px))}.drag-piece.control{filter:drop-shadow(0 0 12rpx rgba(229,185,103,.62))}.drag-piece.done{opacity:.46}.drag-piece.rebound{animation:rebound .24s ease}.drag-piece.hinted{filter:drop-shadow(0 0 16rpx rgba(230,190,92,.9))}@keyframes targetBreath{50%{border-color:rgba(196,142,69,.54);background-color:rgba(255,229,177,.17)}}@keyframes rebound{50%{filter:drop-shadow(0 0 14rpx rgba(166,43,35,.8));transform:scale(.96)}}@media (prefers-reduced-motion:reduce){.drag-target,.drag-piece.rebound{animation:none}.drag-piece{transition:none}}
