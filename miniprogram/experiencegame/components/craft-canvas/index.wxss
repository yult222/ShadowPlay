.craft-canvas{position:relative;width:100%;height:100%;overflow:hidden}.craft-base,.craft-surface{position:absolute;inset:0;width:100%;height:100%}.craft-base{pointer-events:none;filter:drop-shadow(0 10rpx 16rpx rgba(53,31,17,.14))}.craft-base.draft{filter:grayscale(1) sepia(.72);opacity:.16}.craft-base.trace{filter:grayscale(1) sepia(.66);opacity:.24}.craft-base.carve{filter:sepia(.72) saturate(.58);opacity:.52}.craft-base.color{filter:grayscale(1) sepia(.42);opacity:.36}.craft-surface{z-index:3}.craft-canvas.warn{animation:edgeWarn .28s ease}.craft-canvas.error{animation:edgeError .28s ease}@keyframes edgeWarn{50%{filter:drop-shadow(0 0 12rpx rgba(213,166,42,.7))}}@keyframes edgeError{50%{filter:drop-shadow(0 0 14rpx rgba(166,43,35,.72))}}
