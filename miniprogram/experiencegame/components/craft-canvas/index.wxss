.craft-canvas{position:relative;width:100%;height:100%;overflow:hidden}.craft-base,.craft-surface{position:absolute;inset:0;width:100%;height:100%}.craft-base,.craft-reveal{pointer-events:none;filter:drop-shadow(0 10rpx 16rpx rgba(53,31,17,.14))}.craft-base.carve{filter:sepia(.72) saturate(.58);opacity:.34}.craft-base.color{filter:grayscale(1) sepia(.42);opacity:.28}.craft-reveal-frame{position:absolute;z-index:2;pointer-events:none}.craft-reveal{position:absolute;inset:0;width:100%;height:100%;opacity:.94;animation:sourceReveal .26s ease both}.craft-reveal.carve{filter:sepia(.42) saturate(.86) contrast(1.18) brightness(.82)}.craft-reveal.color{filter:saturate(1.04) contrast(1.04)}.craft-hint{position:absolute;z-index:5;width:44px;height:44px;margin:-22px 0 0 -22px;display:flex;align-items:center;justify-content:center;border:2rpx dashed rgba(210,169,101,.74);border-radius:50%;background:rgba(255,237,198,.08);box-sizing:border-box;animation:hintBreath 2.5s ease-in-out infinite}.craft-hint>view{width:12rpx;height:12rpx;border-radius:50%;background:#b73329;box-shadow:0 0 18rpx rgba(183,51,41,.48)}.craft-hint.completed{border-style:solid;border-color:rgba(219,188,131,.32);opacity:.38;animation:none}.craft-hint.completed>view{width:22rpx;height:22rpx;background:#b88b49;box-shadow:inset 0 0 0 5rpx rgba(255,241,208,.42)}.craft-surface{z-index:3;touch-action:none}.craft-canvas.warn{animation:edgeWarn .28s ease}.craft-canvas.error{animation:edgeError .28s ease}@keyframes sourceReveal{from{opacity:.16}to{opacity:.94}}@keyframes hintBreath{50%{transform:scale(1.08);border-color:rgba(239,208,148,.96);background:rgba(255,237,198,.16)}}@keyframes edgeWarn{50%{filter:drop-shadow(0 0 12rpx rgba(213,166,42,.7))}}@keyframes edgeError{50%{filter:drop-shadow(0 0 14rpx rgba(166,43,35,.72))}}@media (prefers-reduced-motion:reduce){.craft-reveal,.craft-hint,.craft-canvas.warn,.craft-canvas.error{animation:none}}
