.craft-canvas{position:relative;width:100%;height:100%;overflow:hidden}.craft-base,.craft-surface{position:absolute;inset:0;width:100%;height:100%}.craft-base,.craft-reveal{pointer-events:none;filter:drop-shadow(0 10rpx 16rpx rgba(53,31,17,.14))}.craft-base.draft{filter:grayscale(1) sepia(.72);opacity:.15}.craft-base.trace{filter:grayscale(1) sepia(.66);opacity:.20}.craft-base.carve{filter:sepia(.72) saturate(.58);opacity:.34}.craft-base.color{filter:grayscale(1) sepia(.42);opacity:.28}.craft-reveal-frame{position:absolute;z-index:2;pointer-events:none}.craft-reveal{position:absolute;inset:0;width:100%;height:100%;opacity:.94;animation:sourceReveal .26s ease both}.craft-reveal.draft{filter:grayscale(1) sepia(.82) contrast(1.28) brightness(.78)}.craft-reveal.trace{filter:grayscale(.92) sepia(.74) contrast(1.38) brightness(.72)}.craft-reveal.carve{filter:sepia(.42) saturate(.86) contrast(1.18) brightness(.82)}.craft-reveal.color{filter:saturate(1.04) contrast(1.04)}.craft-surface{z-index:3;touch-action:none}.craft-canvas.warn{animation:edgeWarn .28s ease}.craft-canvas.error{animation:edgeError .28s ease}@keyframes sourceReveal{from{opacity:.16}to{opacity:.94}}@keyframes edgeWarn{50%{filter:drop-shadow(0 0 12rpx rgba(213,166,42,.7))}}@keyframes edgeError{50%{filter:drop-shadow(0 0 14rpx rgba(166,43,35,.72))}}
