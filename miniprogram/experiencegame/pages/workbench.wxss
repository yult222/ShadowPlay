page{overflow:hidden;background:#26160e}.workbench-page{position:relative;width:100vw;height:100vh;overflow:hidden;background:#28160d}.workbench-bg,.workbench-shade{position:absolute;inset:0;width:100%;height:100%}.workbench-bg{filter:saturate(.92) contrast(1.02)}.workbench-shade{background:linear-gradient(180deg,rgba(31,17,9,.18),rgba(31,17,9,.03) 28%,rgba(31,17,9,.12));pointer-events:none}.board{position:absolute;left:0;overflow:hidden;transition:opacity .22s ease}.board.transitioning{opacity:.08}.stage-layer{position:absolute;inset:0}.assembled-ghost{position:absolute;left:19%;top:6%;width:67%;height:84%;opacity:.18;filter:sepia(.8) grayscale(.35)}.palette{position:absolute;z-index:8;right:18rpx;top:20rpx;display:flex;flex-direction:column;gap:12rpx}.palette-color{width:44px;height:44px;display:flex;align-items:center;justify-content:center;border:1px solid rgba(255,244,220,.48);border-radius:12rpx;box-shadow:0 5rpx 14rpx rgba(30,16,8,.24);color:#fff;font-size:21rpx;text-shadow:0 1px 4rpx rgba(0,0,0,.8);transition:transform .18s ease,box-shadow .18s ease}.palette-color.selected{transform:translateX(-8rpx);box-shadow:0 0 0 4rpx rgba(255,236,197,.65),0 8rpx 20rpx rgba(30,16,8,.32)}.palette-color.recommended{animation:paletteGlow .7s ease}.light-screen{position:absolute;left:25%;top:7%;width:64%;height:72%;border-radius:18rpx;background:radial-gradient(circle at 50% 48%,rgba(255,243,203,.9),rgba(235,185,103,.52) 68%,rgba(85,44,18,.14));box-shadow:inset 0 0 42rpx rgba(255,241,191,.5),0 0 34rpx rgba(226,164,72,.24);transition:filter .5s ease}.light-screen.complete{filter:brightness(1.14)}.light-puppet{position:absolute;z-index:2;left:37%;top:12%;width:42%;height:62%;filter:drop-shadow(12rpx 8rpx 9rpx rgba(45,20,8,.5))}.light-puppet.silhouette{filter:brightness(0) opacity(.8) drop-shadow(16rpx 8rpx 8rpx rgba(45,20,8,.42))}@keyframes paletteGlow{50%{transform:scale(1.14);box-shadow:0 0 26rpx rgba(240,203,113,.95)}}
